# Root-level example. Each package also has its own .env.example.
# Copy what you need to a gitignored .env; never commit real values.

# --- Supabase (local values come from `supabase status`) ---
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Routing ---
VALHALLA_URL=http://localhost:8002
ROUTING_URL=http://localhost:8787

# --- Agent (see agent/.env.example) ---
OWNER_PHONE=
ANTHROPIC_API_KEY=

# --- iOS (goes in ios/Secrets.xcconfig, not here) ---
# GOOGLE_MAPS_IOS_API_KEY=
