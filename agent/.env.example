# Copy to agent/.env (gitignored) and fill in. Never commit real values.

# Top-level Spectrum credentials (from your Photon dashboard).
PROJECT_ID=
PROJECT_SECRET=

# Anthropic API key used to parse incoming texts into structured intents.
ANTHROPIC_API_KEY=

# The ONLY number the agent may ever message, in E.164 format (e.g. +19195551234).
OWNER_PHONE=

# Supabase (local values: `supabase status`). The agent never uses the service-role key.
SUPABASE_URL=

# Routing service base URL.
ROUTING_URL=http://localhost:8787

# Your own Supabase user id (Sharing tab / `select id from auth.users`).
OWNER_USER_ID=
SUPABASE_ANON_KEY=
# Signs 5-minute tokens for OWNER_USER_ID only. Local value: `supabase status` -> JWT_SECRET.
SUPABASE_JWT_SECRET=

# Approach alerts.
ALERT_RADIUS_M=150
POLL_SECONDS=30
# Optional: your dorm, for "approaching your building" when you're not there.
OWNER_HOME_LAT=
OWNER_HOME_LNG=
OWNER_HOME_NAME=
